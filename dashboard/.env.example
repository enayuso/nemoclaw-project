# Copy this file to dashboard/.env and fill in real values. .env is
# gitignored - never commit it, never paste its contents into a chat/AI
# session. This is a SEPARATE .env from the repo root's - the dashboard is
# its own long-running service with its own secret lifecycle, not part of
# bootstrap.sh's flow.

# The real OpenClaw agent gateway's own base origin - NOT the same as
# NEMOCLAW_GATEWAY_PORT (8180, confirmed 2026-07-23 to be OpenShell's own
# separate control-plane API that the nemoclaw CLI itself uses for
# exec/status/etc., not the agent-facing gateway at all). The actual
# gateway is bound inside the sandbox container (10.200.0.2:18789, not
# reachable directly from the host) but NemoClaw already maintains a
# persistent SSH tunnel forwarding it to the host's own 127.0.0.1:18789 -
# confirmed live via `ss -ltnp | grep 18789` showing an ssh process
# listening there, and `nemoclaw ops-nemoclaw dashboard-url`'s own
# "Remote access" instructions assuming exactly this reachability.
# Just the bare origin, no path - gatewayClient.js appends /ws itself and
# derives the required Origin header from this same value (the gateway's
# controlUi.allowedOrigins is a hardcoded allowlist of exactly
# http://127.0.0.1:18789 - confirmed via `openclaw config get gateway`).
NEMOCLAW_GATEWAY_URL=ws://127.0.0.1:18789

# Minted by hand, directly on Server 6, never through an agent (same rule
# as every other real secret in this repo - see bootstrap.sh's header):
#   nemoclaw ops-nemoclaw gateway-token
# Confirm the exact flags via --help first - not yet used anywhere else in
# this repo, so the invocation above is unverified until you run it once.
NEMOCLAW_GATEWAY_TOKEN=

# Single shared login password for the dashboard itself. Plaintext here is
# consistent with how every other secret in this repo is handled, not a
# lesser standard. Known v1 limitation: everyone who has this password
# shows up as "the dashboard" in any run they trigger - no per-user
# attribution. Fine for now, worth knowing.
DASHBOARD_PASSWORD=

# Signs the session cookie. Generate with: openssl rand -hex 32
DASHBOARD_SESSION_SECRET=

# Must be free on Server 6 and distinct from 8080 (Jenkins) and 8180
# (the gateway itself) - confirm with `ss -ltnp` before picking one.
DASHBOARD_PORT=8443

# Self-signed cert is fine for v1 (see README.md for the openssl one-liner
# to generate it). Both must be set together, or the server refuses to
# start in plaintext HTTP - the whole point of these is that credentials
# will transit the open internet once the router port-forward is live.
DASHBOARD_TLS_KEY=
DASHBOARD_TLS_CERT=
