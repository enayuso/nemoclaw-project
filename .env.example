# Copy this file to .env and fill in real values. .env is gitignored - never
# commit it, never paste its contents into a chat/AI session. bootstrap.sh
# reads secrets from here and should be run by a human directly, not by an
# AI agent on your behalf (keeps raw secrets out of any tool-call transcript).

# GitHub classic PAT (repo scope) + username, for cloning this repo itself
# into the sandbox and for cloning whatever repos get registered via
# register-repo.sh.
GITHUB_USERNAME=
GITHUB_PAT=

# GitHub PAT for the GitHub remote MCP server (api.githubcopilot.com/mcp/).
# Use a CLASSIC PAT here, not fine-grained - classic PATs get automatic
# scope-based tool filtering from the MCP server, fine-grained ones don't.
# Can reuse GITHUB_PAT above if its scope is sufficient, or use a separate
# more narrowly-scoped token.
GITHUB_MCP_PAT=

# Server 2 (k3s) read-only monitoring credential - the ServiceAccount token
# and cluster CA cert from k8s/rbac-readonly.yaml, extracted per
# k8s/README.md. This token grants get/list/watch only (no secrets, no
# write verbs) - see that file for exactly what it can and can't do. Still
# a real credential: never commit, never paste into chat/an AI session.
K8S_SA_TOKEN=
K3S_CA_B64=
